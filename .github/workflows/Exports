name: 2. 证书自动签名导出 IPA

on:
  workflow_run:
    workflows: ["1. 编译 Tvbox Archive (真实下载 + 永久 Cache 版)"]
    types:
      - completed
  workflow_dispatch:

jobs:
  export-signed-ipa:
    if: ${{ github.event.workflow_run.conclusion == 'success' || github.event_name == 'workflow_dispatch' }}
    runs-on: macos-15

    steps:
      # 1. 检出仓库代码
      - name: Checkout Code
        uses: actions/checkout@v4

      # 2. 下载上一步编译出的 TVBox.xcarchive 产物
      - name: Download Archive Artifact
        uses: actions/download-artifact@v4
        with:
          name: tvbox-xcarchive
          path: ${{ runner.temp }}/TVBox.xcarchive

      # 3. 安装苹果签名证书和描述文件 (Provisioning Profile) 到 macOS 钥匙串
      - name: Install Apple Certificate and Provisioning Profile
        env:
          BUILD_CERTIFICATE_BASE64: ${{ secrets.CERTIFICATE_P12_BASE64 }}
          P12_PASSWORD: ${{ secrets.P12_PASSWORD }}
          BUILD_PROVISION_PROFILE_BASE64: ${{ secrets.PROVISIONING_PROFILE_BASE64 }}
        run: |
          # 创建临时 Keychain
          KEYCHAIN_PATH=$RUNNER_TEMP/build.keychain-db
          KEYCHAIN_PASSWORD=$(openssl rand -base64 12)
          security create-keychain -p "$KEYCHAIN_PASSWORD" $KEYCHAIN_PATH
          security set-keychain-settings -lut 21600 $KEYCHAIN_PATH
          security unlock-keychain -p "$KEYCHAIN_PASSWORD" $KEYCHAIN_PATH

          # 解码并导入 .p12 证书
          CERTIFICATE_PATH=$RUNNER_TEMP/build_certificate.p12
          echo -n "$BUILD_CERTIFICATE_BASE64" | base64 --decode -o $CERTIFICATE_PATH
          security import $CERTIFICATE_PATH -k $KEYCHAIN_PATH -P "$P12_PASSWORD" -T /usr/bin/codesign
          security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "$KEYCHAIN_PASSWORD" $KEYCHAIN_PATH

          # 解码并安装 .mobileprovision 描述文件
          PP_PATH=$RUNNER_TEMP/app.mobileprovision
          echo -n "$BUILD_PROVISION_PROFILE_BASE64" | base64 --decode -o $PP_PATH
          mkdir -p ~/Library/MobileDevice/Provisioning\ Profiles
          cp $PP_PATH ~/Library/MobileDevice/Provisioning\ Profiles/

      # 4. 自动读取描述文件中的 Signing Team ID 和 App Bundle ID，创建 ExportOptions.plist
      - name: Create ExportOptions.plist
        run: |
          # 自动解析描述文件中的 TeamID 与 UUID
          TEAM_ID=$(security cms -D -i ~/Library/MobileDevice/Provisioning\ Profiles/app.mobileprovision | plutil -extract TeamIdentifier.0 raw -)
          METHOD="development" # 如果是 AdHoc 证书可以改为 ad-hoc，AppStore 证书改为 app-store

          cat <<EOF > $RUNNER_TEMP/ExportOptions.plist
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0">
          <dict>
              <key>method</key>
              <string>${METHOD}</string>
              <key>teamID</key>
              <string>${TEAM_ID}</string>
              <key>signingStyle</key>
              <string>automatic</string>
              <key>compileBitcode</key>
              <false/>
          </dict>
          </plist>
          EOF

      # 5. 执行正式签名与 IPA 导出
      - name: Export Signed IPA
        run: |
          xcodebuild -exportArchive \
            -archivePath $RUNNER_TEMP/TVBox.xcarchive \
            -exportPath $RUNNER_TEMP/output_ipa \
            -exportOptionsPlist $RUNNER_TEMP/ExportOptions.plist \
            -allowProvisioningUpdates

      # 6. 上传签名好的正式 IPA 文件
      - name: Upload Signed IPA Artifact
        uses: actions/upload-artifact@v4
        with:
          name: TVBox-iOS-Signed.ipa
          path: ${{ runner.temp }}/output_ipa/*.ipa
          retention-days: 7
